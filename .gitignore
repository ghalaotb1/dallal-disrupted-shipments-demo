# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated at dev/build time from node_modules
/public/vendor/

# ── Dallal backend (Python) ───────────────────────────────────────────────
# raw + processed third-party data are reproduced from source, never committed
/backend/.data/
/backend/.venv/
/backend/**/__pycache__/
/backend/.pytest_cache/
/backend/.ruff_cache/
/backend/*.egg-info/
/backend/evals/traces/_scratch/
# generated tables. Calibrated model artifacts (<1 MB each, content-hashed in card.json) ARE committed so a hosted backend can serve them;
# the training data they were fitted on is never committed.
*.parquet
!/backend/tests/data/*.parquet
/backend/.fetch*.log
/backend/.build.log
/backend/.baseline.log
