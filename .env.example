# Copy to .env.local. Nothing here is required: without a backend the app runs on its in-browser prototype logic ("Simulated").

# Option A - same-origin proxy (recommended on Vercel; keeps the key server-side). Server-only variables, never NEXT_PUBLIC_:
# DALLAL_BACKEND_URL=https://your-backend-host
# DALLAL_API_KEY=
# NEXT_PUBLIC_DALLAL_API_URL=/api/dallal

# Option B - direct (sandbox demos only; set DALLAL_CORS_ORIGINS on the backend). Do not put a secret in a NEXT_PUBLIC_ variable.
# NEXT_PUBLIC_DALLAL_API_URL=http://localhost:8000
